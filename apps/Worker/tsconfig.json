{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,    // 👈 prevents Prisma/Next typedef errors
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir":"./src",
    "ignoreDeprecations": "6.0",

  },
  "include": ["src/**/*.ts"],              // 👈 compile all .ts files in backend root
  "exclude": ["node_modules", "dist"]
}