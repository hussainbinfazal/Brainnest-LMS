{
  "extends": "../../tsconfig.base.json",  
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "allowJs": true, // 
    "checkJs": false, //
    "jsx": "preserve", //
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "*"
      ],
      "@repo/shared": [
        "../../../packages/shared/src/index.ts"
      ],
      "@repo/shared/*": [
        "../../../packages/shared/src/*"
      ],
      "@repo/payment": [
        "../../../packages/payment/src/index.ts"
      ],
      "@repo/payment/*": [
        "../../../packages/payment/src/*"
      ]
      
    },
    // "ignoreDeprecations": "6.0",
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "global.d.ts",
    "next-auth.d.ts",
    "src",
    "src/types/**/*",
    ".next/types/**/*.ts"
, "../../packages/shared/src/config/cloudinary/cloudinary.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
