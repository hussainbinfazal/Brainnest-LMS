{
    "plugins": [
        "@trivago/prettier-plugin-sort-imports",
        "prettier-plugin-packagejson",
        "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
        "^react",
        "^next",
        "<THIRD_PARTY_MODULES>",
        "^@/(.*)$",
        "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "tailwindFunctions": [
        "cn",
        "clsx",
        "cva"
    ],
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
}